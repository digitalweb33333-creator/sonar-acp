# ---- SONAR ACP — environment (copy to .env, never commit .env) ----
# HTTP server
PORT=10000
PUBLIC_BASE_URL=https://sonar-acp.onrender.com

# ---- ACP v2 seller wiring (leave blank until provided; service runs without them) ----
# Dev wallet whitelisted on the ACP platform (private key, 0x...)
WHITELISTED_WALLET_PRIVATE_KEY=
# Session/entity key id for the seller agent (from app.virtuals.io service registry)
SELLER_ENTITY_ID=
# The seller agent's smart-account wallet address (0x...)
SELLER_AGENT_WALLET_ADDRESS=
# Optional custom RPC for the ACP contract chain (Base). Blank = SDK default.
ACP_RPC_URL=

# ---- Optional upstream API keys (all sources work keyless; keys only raise rate limits) ----
COINGECKO_API_KEY=
# Comma-separated extra EVM RPC urls to prepend to the fallback pool, format chainId|url
EXTRA_RPCS=
